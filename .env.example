# ============================================
# e-Notulen — Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================

# ── Application ──────────────────────────────
APP_NAME=e-notulen
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_APP_NAME=e-Notulen
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_MINIO_URL=http://s3.purbalinggakab.go.id:9000/e-notulen
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# ── PostgreSQL ───────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enotulen
POSTGRES_USER=enotulen
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_SSLMODE=disable

# Connection string (used by backend)
DATABASE_URL=postgres://enotulen:change_me_in_production@postgres:5432/enotulen?sslmode=disable

# ── Keycloak (External — Existing Infrastructure) ──
# Keycloak Server URL (tanpa /auth di beberapa versi Keycloak baru)
KEYCLOAK_ISSUER_URL=https://accounts.purbalinggakab.go.id/auth/realms/apps
KEYCLOAK_CLIENT_ID=e-notulen
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# JWKS endpoint untuk validasi JWT (auto-derived dari issuer, tapi bisa di-override)
KEYCLOAK_JWKS_URL=https://accounts.purbalinggakab.go.id/auth/realms/apps/protocol/openid-connect/certs

# Redirect URIs
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Frontend-specific Keycloak config
NEXT_PUBLIC_KEYCLOAK_URL=https://accounts.purbalinggakab.go.id/auth
NEXT_PUBLIC_KEYCLOAK_REALM=apps
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=e-notulen

# ── MinIO (Object Storage) ───────────────────
MINIO_ENDPOINT=s3.purbalinggakab.go.id:9000
MINIO_ACCESS_KEY=e-notulen
MINIO_SECRET_KEY=RapliGanteng123
MINIO_BUCKET_NAME=e-notulen
MINIO_USE_SSL=false
MINIO_ROOT_USER=e-notulen
MINIO_ROOT_PASSWORD=RapliGanteng123

# ── External API ─────────────────────────────
# API SKPD/OPD (Pemkab Purbalingga)
SKPD_API_URL=https://api.pegawai.e-kinerja.purbalinggakab.go.id/v2/skpd/list?filter_pesona=true
SKPD_API_CACHE_TTL=3600

# ── CORS ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept

# ── Logging ──────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ── File Upload ──────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MAX_ATTACHMENTS_PER_NOTULEN=20
IMAGE_MAX_WIDTH=1920
IMAGE_JPEG_QUALITY=85

# ── PDF Generation ───────────────────────────
PDF_FONT_DIR=./assets/fonts
PDF_DEFAULT_FONT=Times-Roman

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
